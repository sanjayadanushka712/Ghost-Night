#!/usr/bin/env python3
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV_PY = Path.home() / '.local' / 'share' / 'gray_net' / 'venv' / 'bin' / 'python'

if VENV_PY.exists() and sys.executable != str(VENV_PY):
    try:
        import playwright  # noqa: F401
    except ImportError:
        os.execv(str(VENV_PY), [str(VENV_PY), str(ROOT / 'gn')] + sys.argv[1:])

sys.path.insert(0, str(ROOT))

from gray_net.cli import main

if __name__ == '__main__':
    main()
